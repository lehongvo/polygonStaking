# Ad-hoc local key/secret files (CHALLENGE-2665: key.dev.txt was committed with real
# private keys and explorer API keys). Never track files matching this pattern again -
# use .env (gitignored) with .env.example as the sanitized template instead.
key*.txt
key.*.env

# Stores VSCode versions used for testing VSCode extensions
.vscode-test
deployment-info.json

# Internal docs (not for public repo)
docs/

# CHALLENGE-2736: backup/scratch files should never be tracked -- hardhat.config.cjs.bak was
# committed and had gone stale (missing Kaia/Kairos config present in the real file), risking an
# engineer reading it as authoritative.
*.bak
